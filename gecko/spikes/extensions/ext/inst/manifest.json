{
  "manifest_version": 2,
  "name": "Vitre Install Test",
  "version": "1.0",
  "description": "Spike test extension used to drive the install doorhangers.",
  "browser_specific_settings": { "gecko": { "id": "vitre-inst@spike.test" } },
  "icons": { "64": "icon.png" },
  "permissions": ["tabs", "webRequest", "webRequestBlocking", "storage", "<all_urls>"],
  "background": { "scripts": ["bg.js"] },
  "browser_action": {
    "default_icon": { "64": "icon.png" },
    "default_title": "Vitre Install Test",
    "default_area": "navbar"
  }
}
