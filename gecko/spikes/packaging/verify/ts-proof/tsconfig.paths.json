{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "paths": { "chrome://vitre/content/*.mjs": ["./src/*.ts"] }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/vitre-globals.d.ts"]
}
