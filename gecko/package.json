{
  "name": "deer",
  "productName": "Deer",
  "version": "0.1.10",
  "description": "Deer: a liquid-glass browser, as a chrome layer on the Gecko runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "start": "node tools/build.mjs && node tools/start.mjs",
    "launcher": "node tools/build-launcher.mjs",
    "setup-runtime": "node tools/py.mjs tools/setup-runtime.py",
    "test": "node tools/py.mjs tests/core/all.py"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
