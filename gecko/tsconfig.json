{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "chrome://vitre/content/modules/*.sys.mjs": ["./src/modules/*.sys.ts"],
      "chrome://vitre/content/actors/*.sys.mjs": ["./src/actors/*.sys.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
